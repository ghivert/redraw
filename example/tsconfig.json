{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "plugins": [{ "name": "@chouquette/gleam-ts-loader" }]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
